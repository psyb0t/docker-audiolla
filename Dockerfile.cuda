# syntax=docker/dockerfile:1.7
#
# CUDA image: Torchbase with PyTorch cu124 on CUDA 12.6 runtime + Demucs GPU +
# matchering + pedalboard + pyloudnorm + librosa + pysox.
#
# Demucs GPU run: htdemucs / htdemucs_ft / htdemucs_6s / mdx_extra need 3-7GB
# VRAM depending on the model and segment length. Other engines (matchering,
# pedalboard, librosa, sox) are CPU-only; they coexist fine with a GPU build.
#
# Note on GPL: matchering and pedalboard are GPL v3. See Dockerfile note.
#
# Supply chain: same posture as the CPU image. Lightweight deps via
# `uv export --frozen --no-dev` against uv.lock; heavy ML/DSP deps via
# `uv pip install --require-hashes -r requirements-heavy-cuda.txt`.

ARG TORCHBASE_IMAGE=psyb0t/torchbase:py3.12-torch2.5.1-v0.1.1-cu124@sha256:11ccac6fafe5c136cbff749f8690ca2a98d0abe84ce6f673df4db2be7a265d63
FROM ${TORCHBASE_IMAGE} AS dependencies

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/torch-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        ffmpeg sox libsndfile1 libgomp1 libatomic1 \
        fluidsynth fluid-soundfont-gm libchromaprint-tools \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /usr/local/bin/uv

WORKDIR /app

# 1) Lightweight runtime deps from the lockfile.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --group build --no-emit-project --format requirements.txt --output-file /tmp/runtime-requirements.txt \
    && uv pip install --python /opt/torch-venv/bin/python --require-hashes -r /tmp/runtime-requirements.txt \
    && python -c "import torch; assert torch.__version__ == '2.5.1+cu124'"

RUN apt-get update && apt-get install -y --no-install-recommends build-essential cargo \
    && rm -rf /var/lib/apt/lists/*

# 2) Heavy ML / DSP deps: inherited CUDA 12.4 Torch on the CUDA 12.6.3 OS base,
#    hash-locked. See scripts/heavy-deps-cuda.in for the human spec. Pins:
#    torch/torchaudio 2.5.1, demucs 4.0.1, matchering 2.0.6, pedalboard 0.9.20,
#    pyloudnorm 0.1.1, librosa 0.10.2, sox 1.4.1, numpy 2.1.3,
#    soundfile 0.12.1, huggingface-hub 0.34.6.
COPY requirements-heavy-cuda.txt ./
# requirements-heavy-cuda.txt was compiled with --override so that
# numpy==2.1.3 (needed by audio-separator) coexists with deepfilternet's
# over-conservative numpy<2.0 declaration. At install time we extract the
# numpy block (with all its hashes) from the requirements file and pass it
# as the override so uv accepts the constraint conflict.
RUN --mount=type=cache,target=/root/.cache/uv \
    python3 -c "import re,sys; txt=open('requirements-heavy-cuda.txt').read(); m=re.search(r'(numpy==[\d.]+(?:\s*\\\\\n\s+--hash=sha256:[a-f0-9]+)+)', txt); open('/tmp/np-override.txt','w').write(m.group(1).rstrip(' \\\\\n')+'\ntensorflow ; sys_platform == \"never\"\ntensorflow-cpu ; sys_platform == \"never\"\n') if m else sys.exit('numpy block not found')" && \
    uv pip install --python /opt/torch-venv/bin/python --no-config \
        --torch-backend cu124 \
        --require-hashes \
        --override /tmp/np-override.txt \
        -r requirements-heavy-cuda.txt \
    && python -c "import torch, torchaudio; assert torch.__version__ == '2.5.1+cu124'; assert torch.version.cuda == '12.4'; assert torchaudio.__version__.startswith('2.5.1')"

RUN apt-get purge -y --auto-remove build-essential cargo \
    && rm -rf /root/.cache /tmp/np-override.txt

# -----------------------------------------------------------------------------
# Runtime — CUDA 12.6 runtime on ubuntu24.04 (python3.12 in base repos).
FROM dependencies AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/torch-venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    TZ=UTC \
    AUDIOLLA_DEVICE=cuda \
    AUDIOLLA_ENGINES_FILE=/app/engines.json \
    AUDIOLLA_DATA_DIR=/data \
    HF_HOME=/data/hf \
    HF_HUB_OFFLINE=0 \
    AUDIOLLA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    DEBIAN_FRONTEND=noninteractive

RUN mkdir -p /data && chown 1000:1000 /data

WORKDIR /app

COPY --chown=1000:1000 src ./src
COPY --chown=1000:1000 pyproject.toml ./
RUN uv pip install --python /opt/torch-venv/bin/python --no-deps --no-build-isolation .
COPY --chown=1000:1000 engines.json /app/engines.json
COPY --chown=1000:1000 openapi.yaml /app/openapi.yaml
COPY --chown=1000:1000 presets /app/presets
COPY --chown=1000:1000 entrypoint.sh /usr/local/bin/audiolla-entrypoint
RUN chmod +x /usr/local/bin/audiolla-entrypoint

USER 1000:1000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)" || exit 1

ENTRYPOINT ["/usr/local/bin/audiolla-entrypoint"]
