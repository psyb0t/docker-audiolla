# Heavy ML/DSP deps for the CPU prod image. Hand-edited spec.
# Compile to requirements-heavy-cpu.txt via scripts/compile_heavy_deps.sh.
# Versions duplicated in Dockerfile comments must match this file.
# resampy (transitive of matchering) does `import pkg_resources` which only
# exists if setuptools is installed. Modern uv/pip envs don't include it by
# default. Without it, /v1/audio/master mode=reference returns 500.
setuptools==75.6.0
torch==2.5.1+cpu
torchaudio==2.5.1+cpu
demucs==4.0.1
matchering==2.0.6
pedalboard==0.9.20
