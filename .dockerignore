.git/
.gitignore
.dockerignore
.github/
.vscode/
.idea/
.claude/

# Secrets
.env
.env.*
*.env
.envrc
.direnv/
.git-credentials
secrets/
credentials.json
*.pem
*.key
*.p12
*.pfx

# Python caches / build artifacts
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/

# Editor / OS clutter
*.bak
*.orig
*.rej
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.tool-versions
.python-version

# Dev-level markdown — never enters image
CLAUDE.md
ANUSTIMES*.md
implplan.md
NOTES.md
.brutal-review.md
.brutal-review-*.md
*.scratch.md

# Local tooling / personal config
git-update.sh
about.txt
pyrightconfig.json
mypy.ini
.flake8
.research_files/

# Test artifacts / integration scaffolding (not needed in prod image)
tests/
tests/integration/.fixtures/
.e2e-cache/

# Docs — not COPYed by prod Dockerfiles; dev container bind-mounts at runtime
docs/
# openapi.yaml IS shipped into the prod image (v1.0.0) so /openapi.json
# can serve the canonical static spec with tags, parameters, descriptions,
# and oneOf constraints that FastAPI's auto-generated form can't fully
# express. Do not re-ignore it.

# Dev-only Dockerfile + scripts (dev container bind-mounts scripts/ at runtime)
Dockerfile.dev
scripts/

# Repo metadata not needed in image
README.md
CHANGELOG.md
LICENSE
Makefile

# Local compose / Makefile overrides
Makefile.local
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
docker-compose.dev.yaml
docker-compose.dev.yml

# Local model snapshots & ML weights — under no circumstances should
# weights enter the build context. The e2e cache (.e2e-cache/, 29 GB on
# disk after a CUDA UVR run) holds the on-disk HF/torch model store; if
# this glob ever failed open, every build would balloon to GB context
# transfer + bake weights into the layer cache.
/models/
/data/
*.safetensors
*.bin
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.tflite
*.pb
*.mlmodel
*.gguf
*.npz

# Archives — never enter the image; if you need a file, COPY it
# explicitly.
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.zip
*.7z
*.rar

# Node / JS — should never appear in this repo, but cheap insurance
# against an accidental tooling install.
node_modules/

# HF / torch caches that might appear at top level if someone runs the
# server without the container's HF_HOME bind-mount. Belt + braces over
# the .e2e-cache/ + /data/ excludes above.
.hf_cache/
hf_cache/
huggingface/
.torch/
torch_cache/
