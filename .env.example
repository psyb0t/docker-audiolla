# Pass with docker run --env-file .env. Copy this file before adding secrets.
AUDIOLLA_DEVICE=auto
AUDIOLLA_ENGINES_FILE=/app/engines.json
AUDIOLLA_PRESETS_DIR=/app/presets
AUDIOLLA_DATA_DIR=/data
AUDIOLLA_AUTH_TOKEN=your-token-here
AUDIOLLA_ENABLED_ENGINES=
AUDIOLLA_PRELOAD=
AUDIOLLA_ENGINE_TTL=10m
AUDIOLLA_FILES_TTL=24h
AUDIOLLA_SWEEPER_INTERVAL=60
AUDIOLLA_LOAD_TIMEOUT=5m
AUDIOLLA_MAX_UPLOAD_BYTES=209715200
AUDIOLLA_JOB_TTL=1h
AUDIOLLA_JOB_MAX_CONCURRENT=8
AUDIOLLA_FETCH_MODE=disabled
AUDIOLLA_FETCH_HOSTS=
AUDIOLLA_FETCH_SCHEMES=https
AUDIOLLA_FETCH_ALLOW_PRIVATE=false
AUDIOLLA_FETCH_TIMEOUT=30s
AUDIOLLA_FETCH_MAX_REDIRECTS=5
AUDIOLLA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2
AUDIOLLA_UVR_MODELS_DIR=/data/uvr_models
AUDIOLLA_ENABLE_NONCOMMERCIAL=false
HF_HOME=/data/hf
HF_HUB_OFFLINE=0
HF_TOKEN=
HUGGINGFACE_TOKEN=
TORCH_HOME=/data/torch_cache
LOG_LEVEL=INFO
